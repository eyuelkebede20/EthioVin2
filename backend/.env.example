# EthioVin backend — environment variables
# Copy to .env and fill in. The real .env is gitignored and holds secrets.

# --- Required (server throws at boot if missing) ---
DATABASE_URL=postgres://user:password@host:5432/ethiovin
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed CORS origins / better-auth trusted origins (trailing slashes stripped)
FRONTEND_URL=http://localhost:5173,http://localhost:3001

# --- External services (required for verification + AI drafts) ---
GEMINI_API_KEY=your-google-genai-key
SERPER_API_KEY=your-serper-key

# --- Optional ---
PORT=3000
DB_POOL_MAX=5
LOG_RETENTION_DAYS=180

# --- M3 public API platform (billing) ---
# Missing Chapa vars => billing returns 503, but decode still works.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
PUBLIC_API_BASE_URL=https://api.ethiovin.com
