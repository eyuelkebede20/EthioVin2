# EthioVin backend — environment variables
# Copy to .env and fill in. The real .env is gitignored and holds secrets.

# --- Required (server throws at boot if missing) ---
DATABASE_URL=postgres://user:password@host:5432/ethiovin
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed CORS origins / better-auth trusted origins (trailing slashes stripped)
FRONTEND_URL=http://localhost:5173,http://localhost:3001

# --- External services (required for verification + AI drafts) ---
GEMINI_API_KEY=your-google-genai-key
SERPER_API_KEY=your-serper-key

# --- Optional ---
PORT=3000
DB_POOL_MAX=5
LOG_RETENTION_DAYS=180

# --- M3 public API platform (billing) ---
# Missing Chapa vars => billing returns 503, but decode still works.
#
# ZERO-SIGNUP LOCAL TESTING: set BILLING_MOCK_MODE=1 and leave CHAPA_SECRET_KEY EMPTY
# to simulate the whole buy->credit flow with no Chapa account (clicking Buy in the
# portal instantly credits the account). A real CHAPA_SECRET_KEY always overrides this,
# so it can never activate in production. NEVER set this in prod.
BILLING_MOCK_MODE=
# TEST MODE: use a Chapa test secret key (starts with CHASECK_TEST-) — no real money
# moves, and the portal shows a sandbox badge. Swap for the live key (CHASECK-) to go live.
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
# The webhook secret hash from the Chapa dashboard (Settings -> Webhooks). Optional for
# local testing: the billing tab's return-poll settles the purchase without a webhook.
CHAPA_WEBHOOK_SECRET=
# API origin, used in /v1 responses + docs.
PUBLIC_API_BASE_URL=https://api.ethiovin.com
# Web PORTAL origin (where /dashboard/api lives) — the Chapa return_url redirects the
# browser here after checkout. Falls back to the first FRONTEND_URL origin if unset.
# Local dev with the Next portal on :3001: http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3001
